# OpenRouter API key — used for both transcription (audio model) and the interpreter agent.
# Copy this file to `.env.local` and fill in your key. Never commit `.env.local`.
VITE_OPENROUTER_API_KEY=<redacted>
# Agent model on OpenRouter. Flint free works; switch to a Claude model for better Bengali.
VITE_AGENT_MODEL=recursive/flint-v1.0:free
# Hermes server URL — when set, the glasses talk to the server instead of
# OpenRouter directly, and Telegram messages land on the glasses.
# Leave empty for direct mode. Example: VITE_AGENT_URL=http://localhost:3001
VITE_AGENT_URL=

# --- Telegram bot (server) ---
# Create the bot in Telegram: message @BotFather, /newbot, pick a name.
# Paste the token it gives you here. Without it the bot stays off.
TELEGRAM_BOT_TOKEN=
# Your Telegram chat id (message @userinfobot to find it) — glasses turns
# are mirrored into this chat. Optional.
TELEGRAM_CHAT_ID=
# Server port for `npm run server`.
PORT=3001
