# OpenRouter API key — used for both transcription (audio model) and the interpreter agent.
# Copy this file to `.env.local` and fill in your key. Never commit `.env.local`.
VITE_OPENROUTER_API_KEY=<redacted>
# Agent model on OpenRouter. Flint free works; switch to a Claude model for better Bengali.
VITE_AGENT_MODEL=recursive/flint-v1.0:free
